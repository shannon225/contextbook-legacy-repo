<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>maccoss</groupId>
	<artifactId>encyclopedia</artifactId>
	<version>6.10.9-teapot</version>
	<packaging>jar</packaging>

	<name>encyclopedia</name>
	<url>http://maven.apache.org</url>

	<properties>
		<!--
		javacpp presets otherwise resolve native binaries for 11 platforms, of which
		only linux-x86_64 is needed in TEAPOT.
		Remove it to go back to a portable, much larger jar.
		-->
		<javacpp.platform>linux-x86_64</javacpp.platform>
		<!--
		The name of the produced executable JAR.

		If this is set to
		${build.finalName} (which defaults
		to ${artifactId}-${version}), then
		the executable
		JAR will replace the one produced by the
		maven-jar-plugin
		and will be deployed as the result of this build.
		Otherwise, the executable jar is created at target/${targetName}
		and
		is not attached as a maven artifact (the current behavior).

		To attach
		both JARs to the build, you must reconfigure maven-shade-plugin
		to
		attach the executable JAR using <shadedArtifactAttached> and
		<shadedClassifierName>
		in its configuration below.
		-->
		<globalTargetName>encyclopedia-${project.version}-global</globalTargetName>
		<globalBuildTarget>edu.washington.gs.maccoss.encyclopedia.Main</globalBuildTarget>
		<buildGlobal>false</buildGlobal>

		<encyclopediaTargetName>encyclopedia-${project.version}-executable</encyclopediaTargetName>
		<encyclopediaBuildTarget>edu.washington.gs.maccoss.encyclopedia.Encyclopedia</encyclopediaBuildTarget>

		<phosphoTargetName>thesaurus-${project.version}-executable</phosphoTargetName>
		<phosphoBuildTarget>edu.washington.gs.maccoss.encyclopedia.Thesaurus</phosphoBuildTarget>

		<xcordiaTargetName>xcordia-${project.version}-executable</xcordiaTargetName>
		<xcordiaBuildTarget>edu.washington.gs.maccoss.encyclopedia.XCorDIA</xcordiaBuildTarget>

		<walnutTargetName>walnut-${project.version}-executable</walnutTargetName>
		<walnutBuildTarget>edu.washington.gs.maccoss.encyclopedia.Walnut</walnutBuildTarget>

		<scribeTargetName>scribe-${project.version}-executable</scribeTargetName>
		<scribeBuildTarget>edu.washington.gs.maccoss.encyclopedia.Scribe</scribeBuildTarget>

		<!--
		By default, skip failsafe integration tests.
		Reenable by
		running mvn with `-DskipITs=false`
		-->
		<skipITs>true</skipITs>

		<!--
		This should point to the latest stable (NON-SNAPSHOT) build
		of
		EncyclopeDIA. Bitbucket Pipelines should automatically deploy
		the
		reference data jar on a successful build. Please double-check
		the AWS
		repo and ensure that this JAR exists, and if not, set it
		to the most
		recent version. -->
		<regressionReferenceVersion>2.0.0-SNAPSHOT</regressionReferenceVersion>

		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<distributionManagement>
		<repository>
			<id>encyclopedia-maven-repo-releases</id>
			<url>s3://encyclopedia-maven-repo/release/</url>
		</repository>
		<snapshotRepository>
			<id>encyclopedia-maven-repo-snapshots</id>
			<url>s3://encyclopedia-maven-repo/snapshot/</url>
		</snapshotRepository>
	</distributionManagement>

	<repositories>
		<repository>
			<id>encyclopedia-maven-repo-releases</id>
			<url>s3://encyclopedia-maven-repo/release/</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
		<repository>
			<id>encyclopedia-maven-repo-snapshots</id>
			<url>s3://encyclopedia-maven-repo/snapshot/</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
		<repository>
			<id>nexus-ebi-release-repo</id>
			<url>
				https://www.ebi.ac.uk/Tools/maven/repos/content/groups/ebi-repo/</url>
		</repository>
		<repository>
			<id>ebi-repo</id>
			<name>The EBI Maven 2 repository</name>
			<url>https://www.ebi.ac.uk/~maven/m2repo</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
		<repository>
			<id>jzy3d-releases</id>
			<name>Jzy3d Snapshots</name>
			<url>https://maven.jzy3d.org/releases</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
		<repository>
			<id>genesis-maven2-repository</id>
			<name>Genesis maven2 repository</name>
			<url>https://genesis.UGent.be/maven2</url>
			<layout>default</layout>
		</repository>
		<repository>
			<id>jitpack.io</id>
			<url>https://jitpack.io</url>
		</repository>
		<!--  Attempt to override the repository provided
		      by the xxindex
		POM (required for cpdetector).
		      Using a non-HTTPS URL causes an
		error. -->
		<repository>
			<id>sammoa-group</id>
			<url>
				https://maven.nuiton.org/nexus/content/repositories/sammoa-group/</url>
		</repository>
	</repositories>

	<build>
		<extensions>
			<extension>
				<groupId>com.github.seahen</groupId>
				<artifactId>maven-s3-wagon</artifactId>
				<version>1.3.3</version>
			</extension>
		</extensions>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.1</version>
				<configuration>
					<source>17</source>
					<target>17</target>
				</configuration>
			</plugin>
			<plugin>
				<!-- Allows us to properly fetch artifact version
				programmatically in code.
					We do this to save program
				information in files creates by this artifact.
					Usage:
					Class
				k = ...
					k.getPackage().getImplementationVersion() ->
				{$version}
				-->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.3.0</version>
				<configuration>
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
							<addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<version>3.0.0-M5</version>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
						<configuration>
							<skipITs>${skipITs}</skipITs>
							<skipTests>false</skipTests> <!-- ignore setting to
							skip UTs -->
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>3.0.0-M3</version>
				<executions>
					<execution>
						<id>enforce</id>
						<goals>
							<goal>enforce</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<rules>
						<bannedDependencies>
							<excludes>
								<exclude>*:jcl-over-slf4j</exclude>
								<exclude>*:logback-classic</exclude>
								<exclude>*:logback-core</exclude>
							</excludes>
						</bannedDependencies>
					</rules>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- build with `mvn -DbuildJars ...` to create ALL executable JARs -->
		<profile>
			<!-- build with `mvn -PbuildGlobal ...` to create the global
			executable JAR -->
			<id>buildGlobal</id>
			<activation>
				<property>
					<name>buildJars</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-shade-plugin</artifactId>
						<version>3.6.0</version>
						<executions>
							<execution>
								<id>shade-global</id>
								<phase>package</phase>
								<goals>
									<goal>shade</goal>
								</goals>
								<configuration>
									<filters>
										<filter>
											<artifact>*:*</artifact>
											<excludes>
												<exclude>META-INF/*.SF</exclude>
												<exclude>META-INF/*.DSA</exclude>
												<exclude>META-INF/*.RSA</exclude>
											</excludes>
										</filter>
									</filters>
									<finalName>${globalTargetName}</finalName>
									<transformers>
										<transformer
											implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
											<mainClass>${globalBuildTarget}</mainClass>
										</transformer>
									</transformers>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<!-- build with `mvn -PbuildEncyclopedia ...` to create the
			encyclopedia executable JAR -->
			<id>buildEncyclopedia</id>
			<activation>
				<property>
					<name>buildJars</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-shade-plugin</artifactId>
						<executions>
							<execution>
								<id>shade-encyclopedia</id>
								<phase>package</phase>
								<goals>
									<goal>shade</goal>
								</goals>
								<configuration>
									<filters>
										<filter>
											<artifact>*:*</artifact>
											<excludes>
												<exclude>META-INF/*.SF</exclude>
												<exclude>META-INF/*.DSA</exclude>
												<exclude>META-INF/*.RSA</exclude>
											</excludes>
										</filter>
									</filters>
									<finalName>${encyclopediaTargetName}</finalName>
									<transformers>
										<transformer
											implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
											<mainClass>
												${encyclopediaBuildTarget}</mainClass>
										</transformer>
									</transformers>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<!--
			When running ITs, this profile will activate to add the
			necessary test data dependency.
			-->
			<id>integrationTest</id>
			<activation>
				<property>
					<name>skipITs</name>
					<value>false</value>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>maccoss</groupId>
					<artifactId>encyclopedia-test-data</artifactId>
					<version>1-SNAPSHOT</version>
					<scope>test</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<!--
			When running ITs, this profile will activate and package the
			latest
			regression test results into a JAR that will be attached
			to the
			project and deployed. It also will add the necessary
			dependency
			on previously-generated reference data to enable the
			regression
			test comparisons.
			-->
			<id>regressionTest</id>
			<activation>
				<property>
					<name>skipITs</name>
					<value>false</value>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-assembly-plugin</artifactId>
						<version>3.3.0</version>
						<executions>
							<execution>
								<id>assembleReferenceData</id>
								<phase>verify</phase> <!-- must run after ITs -->
								<goals>
									<goal>single</goal>
								</goals>
								<configuration>
									<attach>true</attach>
									<descriptors>
										<descriptor>
											src/reference-data.assembly.xml</descriptor>
									</descriptors>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
			<dependencies>
				<dependency>
					<groupId>maccoss</groupId>
					<artifactId>encyclopedia</artifactId>
					<version>${regressionReferenceVersion}</version>
					<type>jar</type>
					<classifier>reference-data</classifier>
				</dependency>
			</dependencies>
		</profile>
	</profiles>

	<dependencies>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-math3</artifactId>
			<version>3.6</version>
		</dependency>
		<dependency>
			<groupId>
				junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>
				org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
			<version>2.3.4</version>
		</dependency>
		<dependency>
			<groupId>
				uk.ac.ebi.pride.utilities</groupId>
			<artifactId>pride-mod</artifactId>
			<version>2.1.12</version>
			<exclusions>
				<exclusion>
					<groupId>
						org.slf4j</groupId>
					<artifactId>jcl-over-slf4j</artifactId>
				</exclusion>
				<exclusion>
					<groupId>
						ch.qos.logback</groupId>
					<artifactId>logback-classic</artifactId>
				</exclusion>
				<exclusion>
					<groupId>
						ch.qos.logback</groupId>
					<artifactId>logback-core</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>
				org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<version>3.42.0.0</version>
		</dependency>
		<dependency>
			<groupId>
				net.sf.trove4j</groupId>
			<artifactId>trove4j</artifactId>
			<version>3.0.3</version>
		</dependency>
		<dependency>
			<groupId>
				com.google.guava</groupId>
			<artifactId>guava</artifactId>
			<version>18.0</version>
		</dependency>
		<dependency>
			<groupId>
				org.jfree</groupId>
			<artifactId>jfreechart</artifactId>
			<version>1.0.19</version>
		</dependency>
		<dependency>
			<groupId>
				org.jfree</groupId>
			<artifactId>jfreesvg</artifactId>
			<version>3.2</version>
		</dependency>
		<!-- 		<dependency>
			<groupId>org.jzy3d</groupId>
		<artifactId>jzy3d-api</artifactId>
			<version>0.9.1</version>
		</dependency> -->
		<dependency>
			<!-- This version (and before) is LGPL. After that it's AGPL. DO NOT
			UPGRADE! -->
			<groupId>
				com.lowagie</groupId>
			<artifactId>itext</artifactId>
			<version>4.2.0</version>
		</dependency>
		<dependency>
			<groupId>
				com.brsanthu</groupId>
			<artifactId>google-analytics-java</artifactId>
			<version>2.0.0</version>
			<exclusions>
				<exclusion>
					<groupId>
						org.slf4j</groupId>
					<artifactId>jcl-over-slf4j</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- 		<dependency>
			<groupId>com.github.lejon</groupId>
		<artifactId>T-SNE-Java</artifactId>
			<version>v2.5.0</version>
		</dependency> -->

		<!-- support for sorting result TSV -->
		<dependency>
			<groupId>
				com.github.davidmoten</groupId>
			<artifactId>big-sorter</artifactId>
			<version>0.1.15</version>
		</dependency>
		<dependency>
			<groupId>
				org.apache.commons</groupId>
			<artifactId>commons-csv</artifactId>
			<version>1.8</version>
		</dependency>

		<!-- SDK for S3 URI support -->
		<dependency>
			<groupId>
				software.amazon.awssdk</groupId>
			<artifactId>s3-transfer-manager</artifactId>
			<version>
				2.17.123-PREVIEW</version>
		</dependency>
		<dependency>
			<!-- Must be >=4.5.9 for compatibility with AWS SDK -->
			<groupId>
				org.apache.httpcomponents</groupId>
			<artifactId>httpclient</artifactId>
			<version>4.5.13</version>
		</dependency>

		<!-- Java Commons Logging: used for logging from various libraries -->
		<dependency>
			<groupId>
				commons-logging</groupId>
			<artifactId>commons-logging</artifactId>
			<version>1.1.1</version>
		</dependency>

		<!-- Direct libraries using slf4j to pass logs to JCL -->
		<dependency>
			<groupId>
				org.slf4j</groupId>
			<artifactId>slf4j-jcl</artifactId>
			<version>1.7.36</version>
		</dependency>

		<!-- CUT FOR RELEASE -->
		<dependency>
			<groupId>
				org.deeplearning4j</groupId>
			<artifactId>deeplearning4j-core</artifactId>
			<version>
				1.0.0-M2.1</version>
			<!--
			datavec-data-image drags in javacv, and with it opencv, ffmpeg,
			leptonica, tesseract, librealsense, artoolkitplus and a set of camera
			drivers. deeplearning4j-modelimport drags in hdf5-platform. NOTHING
			imports org.datavec or org.deeplearning4j.nn.modelimport. The only DL4J
			packages used are nn, common, util, optimize and zoo.
			-->
			<exclusions>
				<exclusion>
					<groupId>org.datavec</groupId>
					<artifactId>datavec-data-image</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.deeplearning4j</groupId>
					<artifactId>deeplearning4j-modelimport</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.nd4j</groupId>
			<artifactId>
				nd4j-native</artifactId>
			<version>1.0.0-M2.1</version>
		</dependency>
		<dependency>
			<groupId>org.deeplearning4j</groupId>
			<artifactId>deeplearning4j-zoo</artifactId>
			<version>1.0.0-M2.1</version>
		</dependency>
		<!--
		cuda-platform-redist REMOVED for the teapot build.
		To restore GPU support, put this dependency back AND add an nd4j-cuda
		backend; without the backend it does nothing either way.
		-->
		<dependency>
			<groupId>
				org.bytedeco</groupId>
			<artifactId>openblas</artifactId>
			<version>0.3.21-1.5.8</version>
		</dependency>
		<!--
		The linux-x86_64 natives of javacpp and openblas, at the versions
		DL4J 1.0.0-M2.1 brings. ND4J's POMs ask for them with the classifier
		${dependency.platform}, which only a profile of nd4j-backend-impls sets,
		and Maven 3.10 does not activate that profile (it checks for a file) in a
		dependency's POM. Without these two, ND4J cannot load
		(no jniopenblas_nolapack) and PeptideEncodingTest fails.
		-->
		<dependency>
			<groupId>org.bytedeco</groupId>
			<artifactId>javacpp</artifactId>
			<version>1.5.7</version>
			<classifier>linux-x86_64</classifier>
		</dependency>
		<dependency>
			<groupId>org.bytedeco</groupId>
			<artifactId>openblas</artifactId>
			<version>0.3.19-1.5.7</version>
			<classifier>linux-x86_64</classifier>
		</dependency>
		<!-- -->
		
		<dependency>
			<groupId>
				org.json</groupId>
			<artifactId>json</artifactId>
			<version>20240303</version>
		</dependency>
	</dependencies>
</project>
